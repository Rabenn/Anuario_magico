<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.ruben.HelloController">
    <top>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu fx:id="menuFile" text="Archivo">
                            <items>
                                <MenuItem fx:id="menuImportItem" text="Importar Registros..." />
                            </items>
                        </Menu>
                        <Menu fx:id="menuHelp" text="Ayuda">
                            <items>
                                <MenuItem fx:id="menuManualItem" text="Manual de Usuario" />
                            </items>
                        </Menu>
                        <Menu fx:id="menuAccessibility" text="Accesibilidad">
                            <items>

                                <MenuItem fx:id="darkModeItem" text="Modo oscuro" />

                                <Menu text="Tamaño de texto">
                                    <items>
                                        <MenuItem fx:id="textSmallItem" text="Pequeño" />
                                        <MenuItem fx:id="textMediumItem" text="Mediano" />
                                        <MenuItem fx:id="textLargeItem" text="Grande" />
                                    </items>
                                </Menu>

                            </items>
                        </Menu>

                    </menus>
                </MenuBar>

                <StackPane>
                    <children>
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                                    <image>
                                        <Image url="https://upload.wikimedia.org/wikipedia/commons/b/b4/Hogwarts-Crest-4.png" />
                                    </image>
                                </ImageView>
                                <Label fx:id="titleLabel" text="ANUARIO MÁGICO">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Button fx:id="addBtn" text="+" style="-fx-font-size: 18px; -fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                                <Button fx:id="pdfBtn" text="📄" style="-fx-font-size: 18px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" />
                            </children>
                        </HBox>
                        <ComboBox fx:id="langCombo" prefWidth="100.0" StackPane.alignment="CENTER_RIGHT" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </StackPane>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <ComboBox fx:id="filterTypeCombo" prefWidth="150.0" />
                        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" bottom="10.0"/>
                    </padding>
                </HBox>
            </children>
            <padding><Insets bottom="0.0" left="0.0" right="0.0" top="0.0" /></padding>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="rootPane" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" /> </padding>
        </StackPane>
    </center>
</BorderPane>